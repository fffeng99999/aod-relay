# 复制成 .env 后填真实值；.env 不要提交到仓库、不要外传。

# hub 面板密码（默认 admin，建议先在看板「设置」里改掉）
WB_PANEL_PASSWORD=

# 给手机的专用令牌（长随机串）。生成：
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
#   或  openssl rand -base64 32
AOD_RELAY_TOKEN=

# 可选：hub 地址（默认 http://127.0.0.1:8788，即同机本地回环）
#AOD_HUB_URL=http://127.0.0.1:8788

# 可选：有模型缺价时不把金额算作读取失败（AOD 不显示 ¥❌，按已定价部分展示）
#AOD_COST_IGNORE_MISSING=1
